{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_IOS_PTT": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_IOS_PTT": "1"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ENABLE_IOS_PTT": "1",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804514280"
      }
    }
  }
}
