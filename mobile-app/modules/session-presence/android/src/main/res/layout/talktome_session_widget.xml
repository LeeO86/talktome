<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/talktome_widget_background"
  android:orientation="vertical"
  android:padding="12dp"
  android:gravity="center_vertical">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="talktome"
    android:textColor="#F4F7FB"
    android:textSize="18sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:text="Not connected"
    android:textColor="#B8C0CC"
    android:textSize="13sp" />

  <LinearLayout
    android:id="@+id/widget_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <Button
      android:id="@+id/widget_talk"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:background="@drawable/talktome_widget_talk_button"
      android:clickable="true"
      android:focusable="true"
      android:padding="0dp"
      android:text="Reply lock"
      android:textAllCaps="false"
      android:textColor="#F4F7FB"
      android:textSize="12sp"
      android:textStyle="bold" />

    <Button
      android:id="@+id/widget_disconnect"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:background="@drawable/talktome_widget_disconnect_button"
      android:clickable="true"
      android:focusable="true"
      android:padding="0dp"
      android:text="Disconnect"
      android:textAllCaps="false"
      android:textColor="#FF9B94"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
